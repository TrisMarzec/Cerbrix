# Cerbrix server configuration. Copy this file to deploy/server.env and edit it:
#   cp deploy/server.env.example deploy/server.env
# deploy/server.env is git-ignored and must never be committed.

# PostgreSQL credentials. The password is deliberately empty: PostgreSQL refuses to
# start until you set one. Choose a long random, URL-safe password (letters and digits)
# and use the SAME password in POSTGRES_PASSWORD and in CERBRIX_DATABASE__URL below
# (between "cerbrix:" and "@postgres"); compose cannot share it automatically.
POSTGRES_USER=cerbrix
POSTGRES_PASSWORD=
POSTGRES_DB=cerbrix

CERBRIX_DATABASE__URL=postgres://cerbrix:@postgres:5432/cerbrix
CERBRIX_METRICS__URL=http://victoriametrics:8428

# The server listens on this address inside the container; the host side of the port
# mapping is set in docker-compose.yml (local machine only by default).
CERBRIX_SERVER__LISTEN=0.0.0.0:8443

# Plain HTTP, suitable only behind a TLS-terminating reverse proxy or for testing.
CERBRIX_SERVER__INSECURE_HTTP=true

# To serve TLS directly instead: remove the line above, mount your certificate and key
# into the server container (see the commented volume in docker-compose.yml) and set
#   CERBRIX_SERVER__TLS_CERT=/etc/cerbrix/tls/fullchain.pem
#   CERBRIX_SERVER__TLS_KEY=/etc/cerbrix/tls/privkey.pem

# Configuration from a Git repository (GitOps). Disabled by default. When enabled, hosts,
# templates, triggers, notifications, dashboards and displays come from the repository and
# `admin host add` stops working. See docs/install.md ("Configuration from Git") and
# docs/configuration-repository.md. All values below are examples.
#CERBRIX_GITOPS__ENABLED=true
#CERBRIX_GITOPS__URL=https://github.com/your-org/monitoring-config.git
#CERBRIX_GITOPS__BRANCH=main
# Seconds between checks of the repository, 5 to 3600.
#CERBRIX_GITOPS__INTERVAL_SECS=60

# Access to a private repository: a token (https:// URL) or an SSH key (ssh:// or
# user@host:path URL), not both. Leave the token empty for a public repository.
#CERBRIX_GITOPS__TOKEN=
# Absolute paths inside the container; mount the files read-only (see docker-compose.yml).
#CERBRIX_GITOPS__SSH_KEY_FILE=/etc/cerbrix/git/id_ed25519
#CERBRIX_GITOPS__KNOWN_HOSTS_FILE=/etc/cerbrix/git/known_hosts

# Refuse a revision that would deactivate more than this percentage of the active hosts
# (only checked when at least 10 hosts are active), 1 to 100.
#CERBRIX_GITOPS__MAX_HOST_REMOVAL_PERCENT=50
