# Cerbrix server configuration. Copy this file to deploy/server.env and edit it:
#   cp deploy/server.env.example deploy/server.env
# deploy/server.env is git-ignored and must never be committed.

# PostgreSQL credentials. CHANGE THE PASSWORD before the first start, and use the
# same password in CERBRIX_DATABASE__URL below (compose cannot share it automatically).
POSTGRES_USER=cerbrix
POSTGRES_PASSWORD=change-me-before-first-start
POSTGRES_DB=cerbrix

CERBRIX_DATABASE__URL=postgres://cerbrix:change-me-before-first-start@postgres:5432/cerbrix
CERBRIX_METRICS__URL=http://victoriametrics:8428

# The server listens on this address inside the container; publish it with the
# port mapping in docker-compose.yml.
CERBRIX_SERVER__LISTEN=0.0.0.0:8443

# Plain HTTP, suitable only behind a TLS-terminating reverse proxy or for testing.
CERBRIX_SERVER__INSECURE_HTTP=true

# To serve TLS directly instead: remove the line above, mount your certificate and key
# into the server container (see the commented volume in docker-compose.yml) and set
#   CERBRIX_SERVER__TLS_CERT=/etc/cerbrix/tls/fullchain.pem
#   CERBRIX_SERVER__TLS_KEY=/etc/cerbrix/tls/privkey.pem
