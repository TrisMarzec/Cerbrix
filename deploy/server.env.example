# Cerbrix server configuration. Copy this file to deploy/server.env and edit it:
#   cp deploy/server.env.example deploy/server.env
# deploy/server.env is git-ignored and must never be committed.

# PostgreSQL credentials. The password is deliberately empty: PostgreSQL refuses to
# start until you set one. Choose a long random, URL-safe password (letters and digits)
# and use the SAME password in POSTGRES_PASSWORD and in CERBRIX_DATABASE__URL below
# (between "cerbrix:" and "@postgres"); compose cannot share it automatically.
POSTGRES_USER=cerbrix
POSTGRES_PASSWORD=
POSTGRES_DB=cerbrix

CERBRIX_DATABASE__URL=postgres://cerbrix:@postgres:5432/cerbrix
CERBRIX_METRICS__URL=http://victoriametrics:8428

# The server listens on this address inside the container; the host side of the port
# mapping is set in docker-compose.yml (local machine only by default).
CERBRIX_SERVER__LISTEN=0.0.0.0:8443

# Plain HTTP, suitable only behind a TLS-terminating reverse proxy or for testing.
CERBRIX_SERVER__INSECURE_HTTP=true

# To serve TLS directly instead: remove the line above, mount your certificate and key
# into the server container (see the commented volume in docker-compose.yml) and set
#   CERBRIX_SERVER__TLS_CERT=/etc/cerbrix/tls/fullchain.pem
#   CERBRIX_SERVER__TLS_KEY=/etc/cerbrix/tls/privkey.pem

# Configuration from a Git repository (GitOps). Disabled by default. When enabled, hosts,
# templates, triggers, notifications, dashboards and displays come from the repository and
# `admin host add` stops working. See docs/install.md ("Configuration from Git") and
# docs/configuration-repository.md. All values below are examples.
#CERBRIX_GITOPS__ENABLED=true
#CERBRIX_GITOPS__URL=https://github.com/your-org/monitoring-config.git
#CERBRIX_GITOPS__BRANCH=main
# Seconds between checks of the repository, 5 to 3600.
#CERBRIX_GITOPS__INTERVAL_SECS=60

# Access to a private repository: a token (https:// URL) or an SSH key (ssh:// or
# user@host:path URL), not both. For a public repository leave the line commented
# out: an empty value is rejected.
#CERBRIX_GITOPS__TOKEN=
# Absolute paths inside the container; mount the files read-only (see "With an SSH key"
# in docs/install.md).
#CERBRIX_GITOPS__SSH_KEY_FILE=/etc/cerbrix/git/id_ed25519
#CERBRIX_GITOPS__KNOWN_HOSTS_FILE=/etc/cerbrix/git/known_hosts

# For an https:// repository only. git does not see HTTPS_PROXY or SSL_CERT_FILE; use
# these instead (see "Behind a proxy or with a private CA" in docs/install.md).
# Proxy URL: http://, https://, socks5:// or socks5h:// in lower case, host and port only,
# optionally with user:password@ (percent-encoded).
#CERBRIX_GITOPS__PROXY=http://proxy.example.com:3128
# Absolute path inside the container of a PEM file with the certificate authorities to
# trust; it replaces the default bundle for the fetch.
#CERBRIX_GITOPS__CA_FILE=/etc/cerbrix/git/ca.pem

# Refuse a revision that would deactivate more than this percentage of the active hosts
# (only checked when at least 10 hosts are active), 1 to 100.
#CERBRIX_GITOPS__MAX_HOST_REMOVAL_PERCENT=50

# E-mail notifications over SMTP (docs/alerting.md). Disabled while CERBRIX_SMTP__HOST is unset. When it is
# set, CERBRIX_SMTP__FROM is required. All values below are examples.
#CERBRIX_SMTP__HOST=smtp.example.com
# 587 for starttls, 465 for tls.
#CERBRIX_SMTP__PORT=587
# starttls (STARTTLS is required, there is no fallback to plain text), tls (TLS from the
# first byte) or none (plain text, only for a trusted local relay; credentials are
# rejected with none). Certificates are always verified.
#CERBRIX_SMTP__ENCRYPTION=starttls
#CERBRIX_SMTP__FROM=Cerbrix <cerbrix@example.com>
# Seconds allowed for sending one message, 1 to 120.
#CERBRIX_SMTP__TIMEOUT_SECS=15
# Absolute path inside the container of a PEM file with certificate authorities trusted in
# addition to the public ones, for a relay with a certificate from an internal CA (starttls or
# tls).
#CERBRIX_SMTP__CA_FILE=/etc/cerbrix/smtp-ca/ca.pem
# The name sent with EHLO, a host name. Default: the domain of CERBRIX_SMTP__FROM.
#CERBRIX_SMTP__HELLO_NAME=mon.example.com

# Credentials: user name and password are set together. For a server without
# authentication leave both lines commented out: an empty value is not the same as
# leaving the setting out, and an empty password is rejected.
#CERBRIX_SMTP__USERNAME=cerbrix@example.com
#CERBRIX_SMTP__PASSWORD=

# Alerting (see docs/alerting.md). Both settings have defaults; change them only if needed.
# Values measured longer ago than this (seconds, 10 to 86400) are stored but never open or
# close a problem and never cause an e-mail.
#CERBRIX_ALERTING__MAX_VALUE_AGE_SECS=300
# How often the server checks for hosts and items that stopped reporting (seconds, 5 to 300).
#CERBRIX_ALERTING__NODATA_CHECK_SECS=15

# Login of the web UI and its API (docs/install.md, "Login settings"). All have defaults.
# A session unused for this long ends (seconds, 300 to 604800).
#CERBRIX_AUTH__SESSION_IDLE_SECS=43200
# A session ends this long after the login (seconds, not below the idle time, at most 2592000).
#CERBRIX_AUTH__SESSION_MAX_SECS=604800
# Whether the session cookie is marked Secure. Unset: on, unless CERBRIX_SERVER__INSECURE_HTTP
# is true. Set it to true when a reverse proxy terminates TLS in front of this server.
#CERBRIX_AUTH__SECURE_COOKIE=true
# The header whose right-most address is the client address for counting failed logins.
# Unset: the address of the connection. Set it only when every request passes a reverse proxy
# that appends to or sets this header (docs/install.md, "Behind a reverse proxy").
#CERBRIX_AUTH__CLIENT_ADDRESS_HEADER=X-Forwarded-For
# Whether failed logins are counted per client address (default true). Set it to false when all
# clients share one address and no proxy header names the real one, as with Docker Desktop or
# rootless Docker (docs/install.md, "Login settings"). The lock of a user stays either way.
#CERBRIX_AUTH__THROTTLE_LOGINS=false

# Retention (docs/install.md, "Retention"). Problems resolved longer ago than this many days are
# deleted with their notification records, once an hour; open problems are never deleted.
# 0 keeps them for ever, otherwise 1 to 3650. How long metric values are kept is not set here
# but with CERBRIX_METRICS_RETENTION for Docker Compose (shell environment or .env file).
# Upgrade: the first start deletes problems resolved over 365 days ago; set 0 first to keep them.
#CERBRIX_RETENTION__CLOSED_PROBLEMS_DAYS=365
