[Unit]
Description=Cerbrix monitoring agent
Documentation=https://github.com/TrisMarzec/Cerbrix
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cerbrix
Group=cerbrix
ExecStart=/usr/local/bin/cerbrix-agent --config /etc/cerbrix/agent.toml
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

# systemd creates /var/lib/cerbrix-agent owned by the service user; this is the agent's
# default state_dir. It is the only place the service may write to.
StateDirectory=cerbrix-agent
StateDirectoryMode=0750

# Hardening. /proc, /sys and the mount table stay readable: the agent needs them for
# its cpu, memory, disk and network items.
#
# Do NOT add options that hide or replace file systems: ProtectHome=true or =tmpfs,
# PrivateTmp, InaccessiblePaths, TemporaryFileSystem. The agent reads the mount table
# of its own mount namespace, so such options put inaccessible nodes or tmpfs mounts on
# top of real partitions (for example a separate /home) and the disk items report wrong
# sizes or lose the mount. ProtectHome=read-only keeps /home visible.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateDevices=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
