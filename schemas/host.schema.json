{
  "$defs": {
    "Interval": {
      "description": "Collection interval between 1s and 24h, for example \"30s\", \"5m\" or \"1h\".",
      "pattern": "^[0-9]+[smhd]$",
      "type": "string"
    },
    "ItemEntry": {
      "additionalProperties": false,
      "description": "An item a host or template collects.",
      "properties": {
        "interval": {
          "$ref": "#/$defs/Interval"
        },
        "key": {
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "type": "string"
          },
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "key",
        "interval"
      ],
      "type": "object"
    },
    "Severity": {
      "description": "Problem severity. Ordered from least to most severe.",
      "enum": [
        "info",
        "warning",
        "high",
        "critical"
      ],
      "type": "string"
    },
    "TriggerEntry": {
      "additionalProperties": false,
      "description": "A condition that opens a problem.",
      "properties": {
        "expression": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "name",
        "expression",
        "severity"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/TrisMarzec/Cerbrix/main/schemas/host.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A file in `hosts/`.",
  "properties": {
    "address": {
      "type": [
        "string",
        "null"
      ]
    },
    "groups": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "host": {
      "type": "string"
    },
    "items": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ItemEntry"
      },
      "type": "array"
    },
    "templates": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "triggers": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TriggerEntry"
      },
      "type": "array"
    }
  },
  "required": [
    "host"
  ],
  "title": "HostFile",
  "type": "object"
}
